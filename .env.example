# SiteParser — Конфигурация окружения (скопируйте в .env и заполните)
# ================================================================
# 💡 Скопируйте этот файл в .env и укажите свои значения:
#     cp .env.example .env
#
# Команда для запуска:
#     python main.py

# --- DeepSeek API ---
# API-ключ для DeepSeek (обязателен для анализа страниц)
# Получить: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# Модель DeepSeek (по умолчанию: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# --- Парсинг сайта ---
# Стартовый URL для обхода
START_URL=https://it-kirov.info/

# Максимальная глубина обхода (0 — только стартовая страница)
MAX_DEPTH=5

# Задержка между запросами (сек) — чтобы не нагружать сервер
DELAY_SECONDS=1.0

# Таймаут загрузки страницы (сек)
TIMEOUT_SECONDS=10

# --- Вывод ---
# Путь к выходному Excel-файлу
OUTPUT_FILE=output/it_kirov_analysis.xlsx

# Путь к файлу лога
LOG_FILE=parser.log

# --- Обработка текста ---
# Максимальная длина текста страницы (символов) для отправки в API
MAX_TEXT_LENGTH=8000

# Количество повторных попыток при ошибках сети/5xx
RETRY_ATTEMPTS=2
